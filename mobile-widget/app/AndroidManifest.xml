<?xml version="1.0" encoding="utf-8"?>
<!-- DSH Watchdog Widget — 纯只读消费（audit D-权限模型）：仅 INTERNET 权限，
     无任何 mutation 能力；数据源 = adapter /watchdog/status（脱敏投影）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.watchdog.widget"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_widget_icon"
        android:allowBackup="false">

        <activity
            android:name=".WatchdogConfigActivity"
            android:exported="true"
            android:label="@string/config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WatchdogWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dsh.watchdog.widget.ACTION_FETCH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
