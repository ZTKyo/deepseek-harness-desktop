<?xml version="1.0" encoding="utf-8"?>
<!-- DSH Watchdog Widget — 纯只读消费（audit D-权限模型）：仅 INTERNET 权限，
     无任何 mutation 能力；数据源 = adapter /watchdog/status（脱敏投影）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.watchdog.widget"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- R1 B1 事件驱动链：前台服务持有 SSE 长连接（FOREGROUND_SERVICE_DATA_SYNC 为 targetSdk34 必需）；
         RECEIVE_BOOT_COMPLETED 用于重启后自动恢复推送；POST_NOTIFICATIONS 仅用于展示前台通知
         （Android 13+ 拒绝授权时服务仍正常运行，仅通知不可见）。仍零 mutation。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_widget_icon"
        android:allowBackup="false">

        <activity
            android:name=".WatchdogConfigActivity"
            android:exported="true"
            android:label="@string/config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WatchdogWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dsh.watchdog.widget.ACTION_FETCH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".WatchdogEventService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".WatchdogBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
