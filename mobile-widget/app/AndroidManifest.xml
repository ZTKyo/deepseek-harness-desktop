<?xml version="1.0" encoding="utf-8"?>
<!-- DSH Watchdog Widget — 纯只读消费（audit D-权限模型）：数据源 = adapter /watchdog/status
     （脱敏投影）。R3 B（External Review B）无常驻连接改造：删除 SSE 前台服务，
     改为 JobScheduler 15 分钟只读轮询（WatchdogPollReceiver）。
     权限最小化：仅 INTERNET（HTTP 拉取）+ RECEIVE_BOOT_COMPLETED（仅为
     JobScheduler.setPersisted(true) 跨重启保活，无 BOOT receiver 组件）；
     已移除 FOREGROUND_SERVICE / FOREGROUND_SERVICE_DATA_SYNC / POST_NOTIFICATIONS。
     仍零 mutation：无任何写/恢复调用。近实时告警由服务端 Telegram 旁路承担。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.watchdog.widget"
    android:versionCode="2"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 仅为 JobScheduler.setPersisted(true)：15 分钟轮询任务跨重启保活 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_widget_icon"
        android:allowBackup="false">

        <activity
            android:name=".WatchdogConfigActivity"
            android:exported="true"
            android:label="@string/config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WatchdogWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dsh.watchdog.widget.ACTION_FETCH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- R3 B：15 分钟只读轮询 JobService（无常驻连接、无前台通知） -->
        <service
            android:name=".WatchdogPollReceiver"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
